# ==============================================================================
# Opportunity Hunter — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env or real secrets to version control.

# Supabase Public Configuration (Accessible in browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase Server-Only Configuration (NEVER exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n Automation Backend Configuration (Server-side proxy only)
N8N_LEAD_HUNT_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/lead-hunt
N8N_WEBHOOK_SECRET=your-optional-n8n-webhook-secret-token

# SerpApi Configuration (Direct Engine Fallback - Server-side only)
SERPAPI_KEY=your-serpapi-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
